<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Download + install app updates from within the app -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Convert sound for your TV (SoundShare.kt): a foreground service keeps the converter alive with the screen off,
         awake while it converts, on Wi-Fi at full speed; its notification turns it off -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- The TV's programme store, for the launcher's Watch Next row (WatchNext.kt): seen from here under Android 11's package
         visibility. No permission: an app needs none for its own Watch Next rows. -->
    <queries>
        <provider android:authorities="android.media.tv" />
    </queries>

    <!-- Run on both phones and Android TV -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!-- Backups keep settings, add-ons and progress but never the sign-in: see res/xml/backup_rules.xml (Android 11-)
         and data_extraction_rules.xml (12+). -->
    <!-- largeHeap: the player buffers on the Java heap, and a 1 GB TV box's default heap is smaller than the
         engine's stock buffer (PlayerExtras.bufferLoadControl caps it to a third of whatever this gives). -->
    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:targetApi="31"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:largeHeap="true"
        android:theme="@style/Theme.App">

        <!-- configChanges: a Bluetooth keyboard or air-mouse connecting (keyboard), a display or text-size change
             (density, fontScale, colorMode) must not recreate the Activity — the nav stack is plain state, so a
             recreation dropped playback and restarted at Home. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|smallestScreenSize|uiMode|navigation|density|fontScale|colorMode"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="fullUser"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.App">
            <!-- The launcher entries moved to the aliases below (2026-09-28, the app icon perk): this activity keeps the
                 deep link, and every alias opens it. -->
            <!-- Deep link: nebula://play?mpd=<url>&t=<title> launches straight into playback.
                 Used by the addon's "Open in Nebula Player" card via the download site. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="nebula" android:host="play" />
            </intent-filter>
        </activity>

        <!-- The app icons (AppIcons.kt): exactly one of these is on. Classic is the manifest's and carries BOTH launcher
             categories, the same filter MainActivity had — an Android TV launcher (the banner) and the release launch gate
             (`monkey -c LAUNCHER`) find it as before, and a TV never switches. The others are phone-only choices for
             Plus-level supporters, off until picked. -->
        <activity-alias
            android:name=".LauncherClassic"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- phone launcher -->
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- Android TV launcher -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherGold"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_gold"
            android:roundIcon="@mipmap/ic_launcher_gold_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherIce"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_ice"
            android:roundIcon="@mipmap/ic_launcher_ice_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherMono"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_mono"
            android:roundIcon="@mipmap/ic_launcher_mono_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <service
            android:name=".DownloadsService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service
            android:name=".SoundShareService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
