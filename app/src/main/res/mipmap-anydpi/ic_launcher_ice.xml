<?xml version="1.0" encoding="utf-8"?>
<!-- Android 7.1 (Fire OS 6) has no adaptive icons: the same two layers stacked. 8.0+ takes mipmap-anydpi-v26. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ic_launcher_background_ice" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_launcher_foreground_ice" />
</layer-list>
